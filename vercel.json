{
  "crons": [
    { "path": "/api/cron/automation-drain", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/dispatch-notification-emails", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/certificate-expiry-sweep", "schedule": "0 6 * * *" },
    { "path": "/api/cron/handbook-acknowledgment-sweep", "schedule": "30 6 * * *" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
