# My HR Depot — Runtime Configuration
# Copy this file to .env.local and supply all values.
# NEVER commit .env.local to git. Only commit .env.example.

# ── Application ───────────────────────────────────────────────
# The application name shown in the browser title bar
VITE_APP_NAME=My HR Depot

# Current environment: development | staging | production
VITE_APP_ENV=development

# Application version (matches package.json version)
VITE_APP_VERSION=0.1.0

# The public URL of this app — used for auth redirect URLs
# Development:  http://localhost:5173
# Production:   https://your-domain.vercel.app
VITE_APP_URL=http://localhost:5173

# ── Supabase ──────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API

# Your Supabase project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anon/public key (safe to expose in frontend)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Supabase Edge Function used for Google Drive uploads.
VITE_ATTACHMENT_UPLOAD_FUNCTION=mhd-drive-upload

# ── Supabase Auth Setup (do in Supabase Dashboard, not .env) ──
# Authentication → URL Configuration:
#   Site URL:      http://localhost:5173  (dev) | https://your-domain.vercel.app (prod)
#   Redirect URLs: http://localhost:5173/auth/callback
#                  https://your-domain.vercel.app/auth/callback
#                  https://*.vercel.app/auth/callback  (for Vercel preview deploys)

# Per ACR-003, attachment file bytes are stored in Google Drive, not Supabase Storage —
# there is no bucket to configure. See the "Supabase Edge Function Secrets" section of
# `05 - Integration & Deployment/05.1 - Environment-Configuration.md` for the
# GOOGLE_DRIVE_CLIENT_EMAIL / GOOGLE_DRIVE_PRIVATE_KEY / GOOGLE_DRIVE_ROOT_FOLDER_ID
# secrets required by the mhd-drive-upload edge function.
